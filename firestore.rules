rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nhận dạng tài khoản và quyền quản trị
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function owner(uid) { return uid == "Vyd1sYXrKARaTujn0ucX0XFe0gp2"; }
    function admin() {
      return signedIn() && (owner(request.auth.uid) || (exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', 'member') == 'admin'
        && get(userPath(request.auth.uid)).data.get('status', 'active') != 'banned'));
    }
    function active(uid) {
      return signedIn() && request.auth.uid == uid
        && resource.data.get('status', 'active') != 'banned';
    }
    function economyMigrated(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/economy/wallet);
    }
    function privateEconomyRead(uid) {
      return admin() || (signedIn() && request.auth.uid == uid
        && exists(userPath(uid))
        && get(userPath(uid)).data.get('status', 'active') != 'banned');
    }
    function profileFields() {
      return ['state', 'publicId', 'updatedAt', 'displayName', 'email', 'emailLower', 'photoURL'];
    }
    // Chỉ lưu nội dung cá nhân cho tài khoản đã chuyển ví. Bản state cũ,
    // số dư, quyền sở hữu, nhiệm vụ và thống kê thưởng vẫn do máy chủ quản lý.
    function saveMigratedPlanner(changed) {
      let data = request.resource.data;
      let planner = data.get('planner', {});
      return resource.data.get('economyVersion', 0) == 1
        && changed.hasOnly(['planner', 'publicId', 'updatedAt', 'displayName', 'email', 'emailLower', 'photoURL'])
        && (!changed.hasAny(['planner']) || (
          data.keys().hasAll(['planner'])
          && planner is map
          && planner.keys().hasOnly(['settings', 'subjects', 'goal', 'mascot', 'ui', 'room', 'dayNotes'])
          && planner.get('settings', {}) is map
          && planner.get('subjects', []) is list
          && planner.get('goal', {}) is map
          && planner.get('mascot', {}) is map
          && planner.get('ui', {}) is map
          && planner.get('dayNotes', {}) is map
          && planner.get('room', {}) is map
          && planner.get('room', {}).keys().hasOnly(['version', 'theme', 'placed', 'lampOverride', 'weather', 'presets'])
        ));
    }
    function ownerProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return active(uid) && (
        economyMigrated(uid)
        ? (saveMigratedPlanner(changed) || (changed.hasOnly(profileFields()) && !changed.hasAny(['state'])))
        : changed.hasOnly(profileFields())
      );
    }

    function audited(uid) {
      let operation = request.resource.data.lastAdminOperation;
      let auditPath = /databases/$(database)/documents/adminLogs/$(operation);
      let audit = getAfter(auditPath).data;
      return operation is string && !exists(auditPath)
        && audit.actorUid == request.auth.uid && audit.targetUid == uid
        && audit.createdAt == request.time;
    }
    function adminUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return admin()
        && (!economyMigrated(uid) || !changed.hasAny(['adminCredits']))
        && changed.hasOnly(['role', 'status', 'banReason', 'bannedAt', 'bannedBy', 'adminCredits', 'updatedAt', 'lastAdminOperation'])
        && request.resource.data.get('role', 'member') in ['admin', 'member']
        && request.resource.data.get('status', 'active') in ['active', 'banned']
        && request.resource.data.get('adminCredits', 0) is int
        && request.resource.data.get('adminCredits', 0) >= -1000000000
        && request.resource.data.get('adminCredits', 0) <= 1000000000
        && (!changed.hasAny(['role', 'status', 'banReason', 'bannedAt', 'bannedBy'])
          || (uid != request.auth.uid && !owner(uid) && !resource.data.get('owner', false)))
        && request.resource.data.updatedAt == request.time
        && audited(uid);
    }
    // Hồ sơ, đồng bộ dữ liệu và nhật ký quản trị
    match /users/{uid} {
      // Deny banned accounts access to the private user document as well as writes.
      allow get: if signedIn() && ((request.auth.uid == uid
        && (!exists(userPath(uid)) || resource.data.get('status', 'active') != 'banned')) || admin());
      allow list: if admin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(profileFields());
      allow update: if ownerProfileUpdate(uid) || adminUpdate(uid);
      allow delete: if false;
    }
    match /adminLogs/{operation} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorEmail', 'targetUid', 'type', 'requestedValue', 'before', 'after', 'reason', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.type in ['coins-add', 'coins-set', 'role', 'status']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.resource.data.targetUid)).data.lastAdminOperation == operation;
      allow update, delete: if false;
    }
    // Existing school logos and exam schedule remain in their current collection.
    match /universities/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /users/{uid}/notifications/{id} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid
        && get(userPath(uid)).data.get('status', 'active') != 'banned');
      allow write: if admin();
    }
    // Phiên học công khai dùng cho bộ đếm người đang học
    match /studyPresence/{session} {
      allow read: if true;
      allow create, update: if signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('status', 'active') != 'banned'
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt', 'expiresAt', 'focusEndsAt'])
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/studyPresence/$(session)) || resource.data.uid == request.auth.uid)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(120, 's')
        && request.resource.data.focusEndsAt is timestamp
        && request.resource.data.focusEndsAt > request.time
        && request.resource.data.focusEndsAt <= request.time + duration.value(24, 'h');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Canonical economy is server-owned. Admin SDK bypasses Rules;
    // administrators in a browser must use the authenticated server command too.
    match /users/{uid}/{bucket}/{id} {
      allow read: if bucket in ['economy', 'economyOperations', 'ownedItems', 'focusSessions', 'studyDays', 'rewardTasks']
        && privateEconomyRead(uid);
      allow write: if false;
    }
    match /catalog/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
