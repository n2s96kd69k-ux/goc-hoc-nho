rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. XÁC THỰC VÀ QUYỀN QUẢN TRỊ
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // UID chủ sở hữu hệ thống.
    function owner(uid) {
      return uid == "Vyd1sYXrKARaTujn0ucX0XFe0gp2";
    }

    // Chủ sở hữu hoặc tài khoản admin chưa bị khóa.
    function admin() {
      return signedIn() && (
        owner(request.auth.uid) || (
          exists(userPath(request.auth.uid))
          && get(userPath(request.auth.uid))
            .data.get('role', 'member') == 'admin'
          && get(userPath(request.auth.uid))
            .data.get('status', 'active') != 'banned'
        )
      );
    }

    // Chỉ dùng khi kiểm tra document /users/{uid} hiện có.
    function active(uid) {
      return signedIn()
        && request.auth.uid == uid
        && resource.data.get('status', 'active') != 'banned';
    }


    // ============================================================
    // 2. VÍ MÁY CHỦ — ĐIỀU KIỆN CHUYỂN ĐỔI
    // ============================================================

    // Có document này nghĩa là tài khoản đã chuyển sang ví máy chủ.
    //
    // QUAN TRỌNG:
    // Không tạo document này thủ công khi frontend/API mới chưa sẵn sàng.
    // Khi tồn tại, người dùng không được ghi lại toàn bộ "state" cũ,
    // và admin không được phát xu qua "adminCredits" cũ.
    function economyMigrated(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)/economy/wallet
      );
    }

    // Đọc dữ liệu kinh tế riêng tư:
    // admin hoặc chính chủ tài khoản chưa bị khóa.
    function privateEconomyRead(uid) {
      return admin() || (
        signedIn()
        && request.auth.uid == uid
        && exists(userPath(uid))
        && get(userPath(uid))
          .data.get('status', 'active') != 'banned'
      );
    }


    // ============================================================
    // 3. CÁC FIELD NGƯỜI DÙNG ĐƯỢC PHÉP TỰ CẬP NHẬT
    // ============================================================

    function profileFields() {
      return [
        'state',
        'publicId',
        'updatedAt',
        'displayName',
        'email',
        'emailLower',
        'photoURL'
      ];
    }


    // Chỉ lưu nội dung cá nhân cho tài khoản đã chuyển ví. Bản state cũ,
    // số dư, quyền sở hữu, nhiệm vụ và thống kê thưởng vẫn do máy chủ quản lý.
    function saveMigratedPlanner(changed) {
      let data = request.resource.data;
      let planner = data.get('planner', {});
      return resource.data.get('economyVersion', 0) == 1
        && changed.hasOnly(['planner', 'publicId', 'updatedAt', 'displayName', 'email', 'emailLower', 'photoURL'])
        && (!changed.hasAny(['planner']) || (
          data.keys().hasAll(['planner'])
          && planner is map
          && planner.keys().hasOnly(['settings', 'subjects', 'goal', 'mascot', 'ui', 'room', 'dayNotes'])
          && planner.get('settings', {}) is map
          && planner.get('subjects', []) is list
          && planner.get('goal', {}) is map
          && planner.get('mascot', {}) is map
          && planner.get('ui', {}) is map
          && planner.get('dayNotes', {}) is map
          && planner.get('room', {}) is map
          && planner.get('room', {}).keys().hasOnly(['version', 'theme', 'placed', 'lampOverride', 'weather', 'presets'])
        ));
    }
    function ownerProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return active(uid) && (
        economyMigrated(uid)
        ? (saveMigratedPlanner(changed) || (changed.hasOnly(profileFields()) && !changed.hasAny(['state'])))
        : changed.hasOnly(profileFields())
      );
    }

    // ============================================================
    // 4. KIỂM TRA THAO TÁC QUẢN TRỊ VÀ NHẬT KÝ ĐI KÈM
    // ============================================================

    // Thay đổi quản trị phải có nhật ký mới trong cùng transaction/batch.
    function audited(uid) {
      let operation = request.resource.data.lastAdminOperation;
      let auditPath =
        /databases/$(database)/documents/adminLogs/$(operation);
      let audit = getAfter(auditPath).data;

      return operation is string
        && !exists(auditPath)
        && audit.actorUid == request.auth.uid
        && audit.targetUid == uid
        && audit.createdAt == request.time;
    }

    function adminUpdate(uid) {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return admin()

        // Ví mới đã kích hoạt: cấm điều chỉnh xu qua field cũ.
        && (
          !economyMigrated(uid)
          || !changed.hasAny(['adminCredits'])
        )

        && changed.hasOnly([
          'role',
          'status',
          'banReason',
          'bannedAt',
          'bannedBy',
          'adminCredits',
          'updatedAt',
          'lastAdminOperation'
        ])

        && request.resource.data.get('role', 'member')
          in ['admin', 'member']

        && request.resource.data.get('status', 'active')
          in ['active', 'banned']

        && request.resource.data.get('adminCredits', 0) is int
        && request.resource.data.get('adminCredits', 0) >= -1000000000
        && request.resource.data.get('adminCredits', 0) <= 1000000000

        // Không tự đổi quyền/khóa chính mình hoặc tài khoản chủ sở hữu.
        && (
          !changed.hasAny([
            'role',
            'status',
            'banReason',
            'bannedAt',
            'bannedBy'
          ])
          || (
            uid != request.auth.uid
            && !owner(uid)
            && !resource.data.get('owner', false)
          )
        )

        && request.resource.data.updatedAt == request.time
        && audited(uid);
    }


    // ============================================================
    // 5. HỒ SƠ VÀ DỮ LIỆU NGƯỜI DÙNG
    // Đường dẫn: /users/{uid}
    // ============================================================

    match /users/{uid} {
      allow get: if signedIn() && (
        (
          request.auth.uid == uid
          && (
            !exists(userPath(uid))
            || resource.data.get('status', 'active') != 'banned'
          )
        )
        || admin()
      );

      // Chỉ admin được lấy danh sách người dùng.
      allow list: if admin();

      // Người dùng chỉ tạo được hồ sơ của chính mình,
      // không được tự gán role/adminCredits.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(profileFields());

      // Ví cũ tiếp tục lưu state. Ví đã chuyển dùng planner có danh sách trường cho phép.
      allow update: if ownerProfileUpdate(uid) || adminUpdate(uid);

      allow delete: if false;
    }


    // ============================================================
    // 6. NHẬT KÝ QUẢN TRỊ
    // Đường dẫn: /adminLogs/{operation}
    // ============================================================

    match /adminLogs/{operation} {
      allow read: if admin();

      // Nhật ký do frontend quản trị cũ tạo phải liên kết với
      // thay đổi user trong cùng transaction/batch.
      allow create: if admin()
        && request.resource.data.keys().hasOnly([
          'actorUid',
          'actorEmail',
          'targetUid',
          'type',
          'requestedValue',
          'before',
          'after',
          'reason',
          'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.type in [
          'coins-add',
          'coins-set',
          'role',
          'status'
        ]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.resource.data.targetUid))
          .data.lastAdminOperation == operation;

      // Nhật ký đã tạo không được sửa hoặc xóa từ trình duyệt.
      allow update, delete: if false;
    }


    // ============================================================
    // 7. TRƯỜNG ĐẠI HỌC, LOGO VÀ LỊCH THI
    // Đường dẫn: /universities/{id}
    // ============================================================

    match /universities/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }


    // ============================================================
    // 8. THÔNG BÁO CHUNG VÀ BANNER
    // Đường dẫn: /announcements/{id}
    // ============================================================

    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }


    // ============================================================
    // 9. THÔNG BÁO CÁ NHÂN
    // Đường dẫn: /users/{uid}/notifications/{id}
    // ============================================================

    match /users/{uid}/notifications/{id} {
      allow read: if admin() || (
        signedIn()
        && request.auth.uid == uid
        && get(userPath(uid))
          .data.get('status', 'active') != 'banned'
      );

      allow create, update, delete: if admin();
    }


    // ============================================================
    // 10. TRẠNG THÁI ĐANG HỌC POMODORO
    // Đường dẫn: /studyPresence/{session}
    //
    // Dùng cho bộ đếm người đang học.
    // KHÔNG dùng làm bằng chứng để cấp xu.
    // ============================================================

    match /studyPresence/{session} {
      allow read: if true;

      allow create, update: if signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid))
          .data.get('status', 'active') != 'banned'

        && request.resource.data.keys().hasOnly([
          'uid',
          'updatedAt',
          'expiresAt',
          'focusEndsAt'
        ])

        && request.resource.data.uid == request.auth.uid

        // Không được ghi đè phiên của tài khoản khác.
        && (
          !exists(
            /databases/$(database)/documents/studyPresence/$(session)
          )
          || resource.data.uid == request.auth.uid
        )

        && request.resource.data.updatedAt == request.time

        // Phiên phải được gia hạn định kỳ, tối đa 120 giây mỗi lần.
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(120, 's')

        && request.resource.data.focusEndsAt is timestamp
        && request.resource.data.focusEndsAt > request.time
        && request.resource.data.focusEndsAt
          <= request.time + duration.value(24, 'h');

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }


    // ============================================================
    // 11. DỮ LIỆU KINH TẾ DO MÁY CHỦ QUẢN LÝ — MỚI
    //
    // /users/{uid}/economy/{id}          : ví
    // /users/{uid}/economyOperations/{id}: biên nhận giao dịch
    // /users/{uid}/ownedItems/{id}       : vật phẩm sở hữu
    // /users/{uid}/focusSessions/{id}    : phiên học có xác thực
    // /users/{uid}/studyDays/{id}        : thống kê máy chủ
    // /users/{uid}/rewardTasks/{id}      : nhiệm vụ do máy chủ quản lý
    //
    // Trình duyệt chỉ đọc, kể cả tài khoản admin.
    // Máy chủ dùng Admin SDK để ghi và phải tự kiểm tra quyền.
    // ============================================================

    match /users/{uid}/{bucket}/{id} {
      allow read: if bucket in [
        'economy',
        'economyOperations',
        'ownedItems',
        'focusSessions',
        'studyDays',
        'rewardTasks'
      ] && privateEconomyRead(uid);

      allow create, update, delete: if false;
    }


    // ============================================================
    // 12. DANH MỤC GIÁ VẬT PHẨM DO MÁY CHỦ QUẢN LÝ — MỚI
    // Đường dẫn: /catalog/{itemId}
    // ============================================================

    match /catalog/{itemId} {
      allow read: if true;
      allow create, update, delete: if false;
    }


    // ============================================================
    // 13. MẶC ĐỊNH CHẶN CÁC ĐƯỜNG DẪN CHƯA CẤP QUYỀN
    //
    // Firestore cho phép nếu BẤT KỲ match phù hợp nào cho phép.
    // "false" ở đây không phủ định quyền đã được cấp ở mục khác.
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
